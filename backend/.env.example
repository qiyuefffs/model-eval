# ModelGauge 后端环境变量（复制为 .env 后修改）

# === 应用基础 ===
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

# === 数据库 ===
# 默认 SQLite，需切 PostgreSQL 改成 postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=sqlite+aiosqlite:///./platform.db

# === 安全 ===
# 生产环境务必替换！生成方法：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=dev-secret-key-please-change-in-production-32bytes

# === CORS（前端开发地址） ===
# 多个用逗号分隔，pydantic-settings 自动解析为 list
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
